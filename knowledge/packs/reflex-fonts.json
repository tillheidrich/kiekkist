{
 "id": "reflex-fonts",
 "version": "2026-10-30.1",
 "kind": "list",
 "title": "Reflex fonts",
 "description": "Faces that come back far more often than briefs justify. Not bad typefaces: using one in the voice role needs a written reason from the brief. The checker flags them as info (reflex-font); role \"display\" entries count only when they set headings. Brand fonts fixed by the client are exempt (checkTarget brandFonts, CLI --brand-font). typography.md renders its reflex table from this pack.",
 "license": "MIT",
 "reviewed": "2026-10-30",
 "fields": {
  "name": "family name as written",
  "match": "exact | prefix (lower-case comparison with the first family of the computed stack)",
  "role": "any (counts wherever it sets text) | display (counts only in headings)",
  "sectors": "industries where it is the measured sector default",
  "added": "date it was added",
  "retired": "date and reason when removed; retired entries are ignored by the checker"
 },
