{
  "color": {
    "dark": { "ground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.18, 0.006, 255], "hex": "#121417" } },
              "ink": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.94, 0.006, 90], "hex": "#efeee9" } } },
    "light": { "ground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.975, 0.004, 85], "hex": "#f8f7f4" } },
               "ink": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.21, 0.008, 255], "hex": "#16191c" } } },
    "accent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.8, 0.145, 62], "hex": "#f2a14a" } }
  },
  "font": { "family": { "sans": { "$type": "fontFamily", "$value": ["Public Sans Variable", "system-ui", "sans-serif"] } } },
  "space": { "1": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } }, "3": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } } }
}
