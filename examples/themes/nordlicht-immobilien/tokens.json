{
  "$description": "Nordlicht Immobilien design tokens (W3C Design Tokens Community Group format)",
  "color": {
    "paper": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.98,
          0.004,
          240
        ],
        "hex": "#f6f9fb"
      },
      "$description": "Page background, cool paper white"
    },
    "paper-2": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.955,
          0.006,
          240
        ],
        "hex": "#edf1f4"
      },
      "$description": "Data sheet and quiet panels"
    },
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.23,
          0.025,
          255
        ],
        "hex": "#151e29"
      },
      "$description": "Primary text, near-black harbour navy"
    },
    "ink-2": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.45,
          0.02,
          250
        ],
        "hex": "#4d5660"
      },
      "$description": "Secondary text, captions"
    },
    "line": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.86,
          0.008,
          245
        ],
        "hex": "#cdd2d6"
      },
      "$description": "Hairlines"
    },
    "brass": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.66,
          0.085,
          78
        ],
        "hex": "#af8c54"
      },
      "$description": "Accent for rules and markers only (not text on paper)"
    },
    "brass-text": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.47,
          0.08,
          68
        ],
        "hex": "#785224"
      },
      "$description": "Accent when used as text on paper (6.6:1)"
    },
    "deep": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.26,
          0.03,
          245
        ],
        "hex": "#172632"
      },
      "$description": "Dark contact band"
    },
    "on-deep": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.98,
          0.004,
          240
        ],
        "hex": "#f6f9fb"
      },
      "$description": "Text on deep"
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Cormorant Variable",
          "Cormorant",
          "Georgia",
          "serif"
        ]
      },
      "text": {
        "$type": "fontFamily",
        "$value": [
          "Hanken Grotesk Variable",
          "Hanken Grotesk",
          "system-ui",
          "sans-serif"
        ]
      }
    }
  },
  "typography": {
    "display-xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "clamp(3.25rem, 2rem + 6vw, 8.5rem)",
        "fontWeight": 300,
        "lineHeight": 0.92,
        "letterSpacing": "-0.02em"
      }
    },
    "display-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "clamp(2.4rem, 1.6rem + 3.4vw, 4.75rem)",
        "fontWeight": 350,
        "lineHeight": 1,
        "letterSpacing": "-0.015em"
      }
    },
    "display-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem)",
        "fontWeight": 400,
        "lineHeight": 1.08,
        "letterSpacing": "-0.01em"
      }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "1.1875rem",
        "fontWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": "0"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "1rem",
        "fontWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": "0"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "0.75rem",
        "fontWeight": 600,
        "lineHeight": 1.3,
        "letterSpacing": "0.14em"
      }
    },
    "data": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "0.9375rem",
        "fontWeight": 450,
        "lineHeight": 1.4,
        "letterSpacing": "0"
      }
    }
  },
  "dimension": {
    "space": {
      "1": {
        "$type": "dimension",
        "$value": {
          "value": 0.25,
          "unit": "rem"
        }
      },
      "2": {
        "$type": "dimension",
        "$value": {
          "value": 0.5,
          "unit": "rem"
        }
      },
      "3": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "4": {
        "$type": "dimension",
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "5": {
        "$type": "dimension",
        "$value": {
          "value": 2.5,
          "unit": "rem"
        }
      },
      "6": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "rem"
        }
      },
      "7": {
        "$type": "dimension",
        "$value": {
          "value": 7,
          "unit": "rem"
        }
      },
      "8": {
        "$type": "dimension",
        "$value": {
          "value": 11,
          "unit": "rem"
        }
      }
    },
    "radius": {
      "none": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        }
      },
      "hairline": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "px"
        }
      },
      "button": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        }
      }
    }
  }
}
