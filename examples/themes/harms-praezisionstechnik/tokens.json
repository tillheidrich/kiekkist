{
  "$description": "Harms Präzisionstechnik design tokens (W3C Design Tokens Community Group format)",
  "color": {
    "sheet": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.965,
          0.004,
          250
        ],
        "hex": "#f1f4f6"
      },
      "$description": "Background, drawing sheet"
    },
    "panel": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.99,
          0.002,
          250
        ],
        "hex": "#fbfcfd"
      },
      "$description": "Tables and panels"
    },
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.19,
          0.01,
          250
        ],
        "hex": "#101418"
      },
      "$description": "Text and frame lines"
    },
    "ink-2": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.43,
          0.015,
          250
        ],
        "hex": "#4a5158"
      },
      "$description": "Secondary text"
    },
    "grid": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.85,
          0.01,
          245
        ],
        "hex": "#c9cfd4"
      },
      "$description": "Grid and table rules"
    },
    "line": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.48,
          0.09,
          245
        ],
        "hex": "#2c628d"
      },
      "$description": "Drawing lines and dimension lines (blueprint blue)"
    },
    "signal": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.86,
          0.17,
          95
        ],
        "hex": "#f4ce23"
      },
      "$description": "Signal yellow, only as fill behind ink"
    },
    "steel": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.25,
          0.015,
          245
        ],
        "hex": "#1c2328"
      },
      "$description": "Dark bands"
    },
    "ok": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5,
          0.12,
          150
        ],
        "hex": "#21763c"
      },
      "$description": "Status: in tolerance / done"
    },
    "hold": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.55,
          0.15,
          55
        ],
        "hex": "#ac5700"
      },
      "$description": "Status: waiting (decorative, with text label)"
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Archivo Variable",
          "Archivo",
          "Arial Narrow",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "IBM Plex Mono",
          "ui-monospace",
          "monospace"
        ]
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "clamp(2.5rem, 1.4rem + 4.6vw, 6rem)",
        "fontWeight": 800,
        "lineHeight": 0.9,
        "letterSpacing": "-0.01em"
      },
      "$extensions": {
        "org.kiekkist.fontStretch": "68%"
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem)",
        "fontWeight": 750,
        "lineHeight": 1,
        "letterSpacing": "0"
      },
      "$extensions": {
        "org.kiekkist.fontStretch": "75%"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "1rem",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "$extensions": {
        "org.kiekkist.fontStretch": "100%"
      }
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "0.875rem",
        "fontWeight": 450,
        "lineHeight": 1.45,
        "letterSpacing": "0"
      },
      "$extensions": {
        "org.kiekkist.fontStretch": "100%"
      }
    },
    "value": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "0.875rem",
        "fontWeight": 500,
        "lineHeight": 1.35,
        "letterSpacing": "0"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "0.6875rem",
        "fontWeight": 500,
        "lineHeight": 1.2,
        "letterSpacing": "0.06em"
      }
    }
  },
  "dimension": {
    "space": {
      "1": {
        "$type": "dimension",
        "$value": {
          "value": 0.25,
          "unit": "rem"
        }
      },
      "2": {
        "$type": "dimension",
        "$value": {
          "value": 0.5,
          "unit": "rem"
        }
      },
      "3": {
        "$type": "dimension",
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "4": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "5": {
        "$type": "dimension",
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "6": {
        "$type": "dimension",
        "$value": {
          "value": 2.5,
          "unit": "rem"
        }
      },
      "7": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "rem"
        }
      }
    },
    "radius": {
      "none": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        }
      },
      "chip": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        }
      },
      "hole": {
        "$type": "dimension",
        "$value": "50%"
      }
    }
  }
}
