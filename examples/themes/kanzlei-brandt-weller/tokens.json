{
  "$description": "Kanzlei Brandt Weller design tokens (W3C Design Tokens Community Group format)",
  "color": {
    "paper": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.975,
          0.002,
          95
        ],
        "hex": "#f7f7f5"
      },
      "$description": "Page background, neutral paper"
    },
    "margin": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.945,
          0.003,
          95
        ],
        "hex": "#ededea"
      },
      "$description": "Margin column and table heads"
    },
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.21,
          0.008,
          260
        ],
        "hex": "#16181c"
      },
      "$description": "Text, graphite"
    },
    "ink-2": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.42,
          0.01,
          260
        ],
        "hex": "#4a4d53"
      },
      "$description": "Secondary text, margin notes"
    },
    "rule": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8,
          0.004,
          95
        ],
        "hex": "#bebebb"
      },
      "$description": "Rules"
    },
    "rule-strong": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.21,
          0.008,
          260
        ],
        "hex": "#16181c"
      },
      "$description": "Section rules, 2px"
    },
    "green": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.41,
          0.07,
          162
        ],
        "hex": "#20563f"
      },
      "$description": "Accent: file-folder green, links and case references"
    },
    "green-soft": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.93,
          0.02,
          162
        ],
        "hex": "#ddece4"
      },
      "$description": "Highlight behind a case reference"
    }
  },
  "font": {
    "family": {
      "serif": {
        "$type": "fontFamily",
        "$value": [
          "Source Serif 4 Variable",
          "Source Serif 4",
          "Georgia",
          "serif"
        ]
      },
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Public Sans Variable",
          "Public Sans",
          "system-ui",
          "sans-serif"
        ]
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.serif}",
        "fontSize": "clamp(2.25rem, 1.5rem + 3.2vw, 4.5rem)",
        "fontWeight": 420,
        "lineHeight": 1.06,
        "letterSpacing": "-0.012em"
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.serif}",
        "fontSize": "clamp(1.5rem, 1.2rem + 1vw, 2.125rem)",
        "fontWeight": 500,
        "lineHeight": 1.15,
        "letterSpacing": "-0.005em"
      }
    },
    "lead": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.serif}",
        "fontSize": "clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem)",
        "fontWeight": 400,
        "lineHeight": 1.45,
        "letterSpacing": "0"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.serif}",
        "fontSize": "1.125rem",
        "fontWeight": 400,
        "lineHeight": 1.62,
        "letterSpacing": "0"
      }
    },
    "meta": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "0.8125rem",
        "fontWeight": 500,
        "lineHeight": 1.45,
        "letterSpacing": "0.01em"
      }
    },
    "smallcaps": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "0.75rem",
        "fontWeight": 650,
        "lineHeight": 1.3,
        "letterSpacing": "0.12em"
      }
    }
  },
  "dimension": {
    "space": {
      "1": {
        "$type": "dimension",
        "$value": {
          "value": 0.25,
          "unit": "rem"
        }
      },
      "2": {
        "$type": "dimension",
        "$value": {
          "value": 0.5,
          "unit": "rem"
        }
      },
      "3": {
        "$type": "dimension",
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "4": {
        "$type": "dimension",
        "$value": {
          "value": 1.25,
          "unit": "rem"
        }
      },
      "5": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "rem"
        }
      },
      "6": {
        "$type": "dimension",
        "$value": {
          "value": 3.5,
          "unit": "rem"
        }
      },
      "7": {
        "$type": "dimension",
        "$value": {
          "value": 5.5,
          "unit": "rem"
        }
      }
    },
    "radius": {
      "none": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}
