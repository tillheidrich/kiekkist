  "font": {
    "family": {
      "serif": {
        "$type": "fontFamily",
        "$value": [
          "Newsreader Variable",
          "Newsreader",
          "Newsreader Fallback",
          "Newsreader Fallback DejaVu",
          "Georgia",
          "serif"
        ]
      },
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Familjen Grotesk Variable",
          "Familjen Grotesk",
          "Familjen Grotesk Fallback",
          "Familjen Grotesk Fallback DejaVu",
          "system-ui",
          "sans-serif"
        ]
      }
    }
  },
  "typography": {
    "thesis": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.serif}",
        "fontSize": "clamp(2.5rem, 1.2rem + 5.4vw, 7rem)",
        "fontWeight": 340,
        "lineHeight": 1,
        "letterSpacing": "-0.025em"
      }
    },
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.serif}",
        "fontSize": "clamp(2rem, 1.3rem + 2.6vw, 3.75rem)",
        "fontWeight": 360,
        "lineHeight": 1.05,
        "letterSpacing": "-0.02em"
      }
    },
    "service": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.serif}",
        "fontSize": "clamp(1.5rem, 1.1rem + 1.5vw, 2.5rem)",
        "fontWeight": 380,
        "lineHeight": 1.1,
        "letterSpacing": "-0.01em"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "1.0625rem",
        "fontWeight": 400,
        "lineHeight": 1.55,
        "letterSpacing": "0"
      }
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "0.875rem",
        "fontWeight": 500,
        "lineHeight": 1.45,
        "letterSpacing": "0.005em"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "0.8125rem",
        "fontWeight": 600,
        "lineHeight": 1.3,
        "letterSpacing": "0.02em"
      }
    }
  },
  "dimension": {
    "space": {
      "1": {
        "$type": "dimension",
        "$value": {
          "value": 0.25,
          "unit": "rem"
        }
      },
      "2": {
        "$type": "dimension",
        "$value": {
          "value": 0.5,
          "unit": "rem"
        }
      },
      "3": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "4": {
        "$type": "dimension",
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "5": {
        "$type": "dimension",
        "$value": {
          "value": 2.5,
          "unit": "rem"
        }
      },
      "6": {
        "$type": "dimension",
        "$value": {
          "value": 4.5,
          "unit": "rem"
        }
      },
      "7": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "rem"
        }
      }
    },
    "radius": {
      "none": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        }
      },
      "dot": {
        "$type": "dimension",
        "$value": "50%"
      },
      "field": {
        "$type": "dimension",
        "$value": {
          "value": 3,
          "unit": "px"
        }
      }
    }
